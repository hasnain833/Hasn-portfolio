# --- Required ---------------------------------------------------------------
# MongoDB connection (the site and the admin read and write here)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB=portfolio

# Admin sign-in password for /admin
ADMIN_PASSWORD=choose-a-long-password
# Secret used to sign the admin session cookie. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Cloudinary (screenshot uploads in the admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional ---------------------------------------------------------------
# Optional second domain that serves only the admin (e.g. admin.example.com).
# When set, /admin is hidden on the main site and this domain opens straight into the admin.
ADMIN_HOST=

# Public URL, used for link previews, the sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.has-nain.dev
# Résumé button. Falls back to the current Google Drive link if not set.
NEXT_PUBLIC_RESUME_LINK=
NEXT_PUBLIC_GITHUB_URL=https://github.com/hasnain833
